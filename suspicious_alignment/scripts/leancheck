#!/bin/bash
# Serialised Lean checks: at most 3 Lean processes run at once on this 4-core / 15 GB machine.
#   scripts/leancheck SuspiciousAlignment/Foo.lean      type-check one file
#   scripts/leancheck --build SuspiciousAlignment.Foo   build one module (makes it importable)
export PATH=$HOME/.elan/bin:$PATH
cd "${LEANCHECK_DIR:-/home/user/htmuon/suspicious_alignment}" || exit 2
LOCKDIR=/tmp/leanlocks; mkdir -p "$LOCKDIR"
while true; do
  for i in 1 2 3; do
    exec {fd}>"$LOCKDIR/slot$i"
    if flock -n "$fd"; then
      if [ "$1" = "--build" ]; then timeout 2400 lake build "$2"; else timeout 1200 lake env lean "$@"; fi
      exit $?
    fi
    exec {fd}>&-
  done
  sleep 3
done
